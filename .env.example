# ==============================================================================
# TripMate AI - Environment Variables Template
# ==============================================================================
# Instructions:
# 1. Copy this file to '.env':
#      cp .env.example .env
# 2. Fill in your actual API keys and database URL below.
# 3. NEVER commit your '.env' file containing real secrets to GitHub!
#    (.gitignore is already configured to ignore '.env')
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. LLM Provider (Required)
# ------------------------------------------------------------------------------
# Groq API Key used for the Llama-3.3-70b model in backend.py & mcp_client.py
# Get a key from: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
# Optional Groq Model (defaults to openai/gpt-oss-120b or qwen/qwen3.8-27b)
GROQ_MODEL=openai/gpt-oss-120b

# ------------------------------------------------------------------------------
# 2. Database (Required for LangGraph state persistence)
# ------------------------------------------------------------------------------
# PostgreSQL database connection string used by PostgresSaver checkpointer.
# You can use a free cloud PostgreSQL database (e.g., Render, Neon, Supabase)
# or a local PostgreSQL instance.
# Example: postgresql://user:password@hostname:5432/dbname
DATABASE_URL=postgresql://username:password@host:port/database_name

# ------------------------------------------------------------------------------
# 3. MCP Search Tools (Required for agent tool execution)
# ------------------------------------------------------------------------------
# Tavily API key for web search MCP adapter
# Get a key from: https://tavily.com
TAVILY_API_KEY=your_tavily_api_key_here

# OpenWeatherMap API key for the weather MCP server (custom_weather_mcp_server.py)
# Get a key from: https://openweathermap.org/api
OPENWEATHER_API_KEY=your_openweather_api_key_here

# AviationStack API key for flight status / flight search MCP adapter
# Get a key from: https://aviationstack.com
AVIATION_STACK_API_KEY=your_aviationstack_api_key_here
